<?xml version="1.0" encoding="utf-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="tilek">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="app_user">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(50)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="password" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="tilek">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="course">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="course_name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="teacher_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="course_student">
            <column name="course_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="course_student"
                columnNames="course_id, student_id"
                constraintName="uk_course_student"/>

        <addForeignKeyConstraint
                baseTableName="course"
                baseColumnNames="teacher_id"
                constraintName="fk_course_teacher"
                referencedTableName="app_user"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="course_student"
                baseColumnNames="course_id"
                constraintName="fk_cs_course"
                referencedTableName="course"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="course_student"
                baseColumnNames="student_id"
                constraintName="fk_cs_student"
                referencedTableName="app_user"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="3" author="tilek">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="user"/>
        </preConditions>
        <renameTable oldTableName="user" newTableName="app_user"/>
    </changeSet>

    <changeSet id="4" author="tilek">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="course_student"/>
        </preConditions>
        <addUniqueConstraint
                tableName="course_student"
                columnNames="course_id, student_id"
                constraintName="uk_course_student_v2"/>
    </changeSet>

</databaseChangeLog>
